# Copy this file to .env and fill in keys before running experiments.
# .env is git-ignored; this .env.example documents the required variables.

# --- Commercial API keys (each provider billed separately) ---
DEEPSEEK_API_KEY=sk-...                 # https://platform.deepseek.com
DASHSCOPE_API_KEY=sk-...                # Alibaba DashScope (for Qwen3-Plus API tier)
MINIMAX_API_KEY=sk-...                  # https://api.minimaxi.com (Anthropic-compat endpoint)

# --- OpenCode Zen gateway (multi-vendor aggregator: GPT-5.x, Claude Opus/Sonnet) ---
OPENCODE_ZEN_KEY=sk-...                 # https://opencode.ai/zen

# --- Local Ollama (for Qwen3.6 and the safety-stripped Qwen3.5-uncensored red) ---
OLLAMA_LOCAL_API_KEY=ollama             # Ollama does not require auth; dummy value
